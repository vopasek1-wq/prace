rules_version = '2';

// Jimmy – pravidla Firestore.
// Přístup mají jen e-maily uvedené v kolekci `allowlist` (max. 6 lidí).
service cloud.firestore {
  match /databases/{db}/documents {

    function isMember() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(db)/documents/allowlist/$(request.auth.token.email));
    }

    function reactionKeys() {
      return ['thumbs_up', 'green', 'red', 'orange'];
    }

    // U reakce `k` smí uživatel přidat nebo odebrat jen sebe sama.
    function ownChangeOnly(k) {
      let before = resource.data.reactions[k].toSet();
      let after = request.resource.data.reactions[k].toSet();
      return after.difference(before).hasOnly([request.auth.uid])
          && before.difference(after).hasOnly([request.auth.uid]);
    }

    function onlyOwnReactionChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.keys().hasOnly(reactionKeys())
          && ownChangeOnly('thumbs_up')
          && ownChangeOnly('green')
          && ownChangeOnly('red')
          && ownChangeOnly('orange');
    }

    function validNewMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['senderId', 'type', 'text', 'photo', 'reactions', 'createdAt'])
          && d.senderId == request.auth.uid
          && d.text is string
          && d.text.size() <= 4000
          && d.createdAt == request.time
          && d.reactions == {'thumbs_up': [], 'green': [], 'red': [], 'orange': []}
          && (
               (d.type == 'text' && d.photo == null && d.text.size() > 0)
            || (d.type == 'photo' && d.photo is map && d.photo.driveFileId is string)
          );
    }

    // `exists()` obchází pravidla, takže allowlist klienti číst ani měnit nemusí.
    match /allowlist/{email} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isMember();
      allow create, update: if isMember()
          && request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // Místnosti zakládá administrátor (konzole nebo tools/seed.mjs), klienti je jen čtou.
    match /rooms/{roomId} {
      allow read: if isMember();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isMember();
        allow create: if isMember() && validNewMessage();
        allow update: if isMember() && onlyOwnReactionChange();
        allow delete: if false;
      }
    }
  }
}
